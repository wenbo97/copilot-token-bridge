{
  "name": "copilot-token-bridge",
  "displayName": "Copilot Token Bridge",
  "description": "Expose your VS Code GitHub Copilot internal token over a local HTTP endpoint for use by other tools",
  "version": "0.2.0",
  "publisher": "wenbo97",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenbo97/copilot-token-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/wenbo97/copilot-token-bridge/issues"
  },
  "homepage": "https://github.com/wenbo97/copilot-token-bridge#readme",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-token-bridge.startServer",
        "title": "Copilot Token Bridge: Start Server"
      },
      {
        "command": "copilot-token-bridge.stopServer",
        "title": "Copilot Token Bridge: Stop Server"
      },
      {
        "command": "copilot-token-bridge.setPort",
        "title": "Copilot Token Bridge: Set Port"
      },
      {
        "command": "copilot-token-bridge.showMenu",
        "title": "Copilot Token Bridge: Show Menu"
      }
    ],
    "configuration": {
      "title": "Copilot Token Bridge",
      "properties": {
        "copilot-token-bridge.port": {
          "type": "number",
          "default": 18774,
          "minimum": 1,
          "maximum": 65535,
          "description": "TCP port for the local token endpoint. Bound to 127.0.0.1. Restart the server (or VS Code) for changes to take effect."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "local:release": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
